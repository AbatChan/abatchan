NIKA_AI_PROVIDER=openai
NIKA_AI_API_KEY=replace-with-your-provider-key
NIKA_AI_MODEL=gpt-4o-mini
# Required only for an OpenAI-compatible provider:
# NIKA_AI_ENDPOINT=https://provider.example/v1/chat/completions
NIKA_PUBLIC_ORIGIN=https://www.example.com
NIKA_PORT=8787
NIKA_HOURLY_LIMIT=20
# Use a long random value. It hashes visitor addresses before local storage.
NIKA_HASH_SECRET=replace-with-a-long-random-secret
