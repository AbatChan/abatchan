NIKA_AI_PROVIDER=openai
NIKA_AI_API_KEY=replace-with-your-provider-key
NIKA_AI_MODEL=gpt-4o-mini
# Required for the private settings page at /nika/admin.
NIKA_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Required only for an OpenAI-compatible provider:
# NIKA_AI_ENDPOINT=https://provider.example/v1/chat/completions
NIKA_PUBLIC_ORIGIN=https://www.example.com
NIKA_PORT=8787
NIKA_HOURLY_LIMIT=20
NIKA_DAILY_LIMIT=500
# Optional server-managed exemptions. These stay active and are not removable in the admin page.
# NIKA_EXEMPT_IPS=203.0.113.24,2001:db8::24
# Use a long random value. It hashes visitor addresses before local storage.
NIKA_HASH_SECRET=replace-with-a-long-random-secret
# Optional: scan a mounted static-site directory for new and changed HTML.
# NIKA_SITE_ROOT=/site
# NIKA_AUTO_INDEX_SECONDS=60
